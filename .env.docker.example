# Copy to `.env` (or set in Dokploy → Environment) for local docker-compose use.
# These are runtime secrets read by the app's route handlers.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Mutually exclusive with DEEPSEEK_API_KEY
ZAI_API_KEY=
ZAI_MODEL=glm-5.1

# Inlined at build time via NEXT_PUBLIC_ build args (uncomment if your app needs it)
NEXT_PUBLIC_APP_URL=
